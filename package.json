{
  "name": "level-1-builder",
  "private": true,
  "version": "2.1.0",
  "description": "Level 1 — Product-Minded AI Builder. A local-first personal apprenticeship system. Protect the floor. Raise the ceiling.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "vitest run && npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
